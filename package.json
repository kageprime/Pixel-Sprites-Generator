{
  "name": "veilspire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/manifest.mjs",
    "toons": "node scripts/copy-toons.mjs",
    "predev": "npm run gen --silent && npm run toons --silent",
    "prebuild": "npm run gen --silent && npm run toons --silent",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
